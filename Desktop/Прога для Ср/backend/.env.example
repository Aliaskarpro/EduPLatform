NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/eduplatform
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
CSRF_SECRET=your-super-secret-csrf-key-change-in-production

# SMTP Configuration (optional - for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eduplatform.com

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173
