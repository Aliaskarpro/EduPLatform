# =================================
# EDUPLATFORM ENVIRONMENT VARIABLES
# =================================

# CRITICAL: These MUST be set before running the application
# Copy this file to .env and fill in the values

# ========== DATABASE ==========
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/eduplatform

# ========== JWT AUTHENTICATION ==========
# CRITICAL: Generate a secure random string (minimum 32 characters)
# Example generation: openssl rand -base64 32
# NEVER use 'secret' or any simple value in production
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this

# JWT token expiration time
JWT_EXPIRES_IN=7d

# ========== BCRYPT ==========
# Number of salt rounds for password hashing
# Higher = more secure but slower (recommended: 12)
BCRYPT_ROUNDS=12

# ========== CORS ==========
# CRITICAL: Must be set to your actual frontend URL(s)
# Multiple origins: separate with commas
# Development: http://localhost:5173
# Production: https://yourdomain.com
# NEVER use '*' in production
CORS_ORIGIN=http://localhost:5173

# ========== SERVER ==========
# Port the backend server will run on
PORT=3001

# Node environment
NODE_ENV=development

# ========== SECURITY NOTES ==========
# 1. NEVER commit .env files to git
# 2. Use different secrets for dev/staging/production
# 3. Rotate JWT_SECRET periodically
# 4. Store production secrets in a vault (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. Enable database SSL in production
